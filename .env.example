# ZENLABS — example environment file.
#
# This is the ONLY .env* file that may be tracked (FF-19). Copy it to `.env`,
# which is gitignored, and fill in local values. Never commit a real value:
# runtime credentials come from AWS Secrets Manager (ADR-0022, FF-14).

# architecture.md §8 — development | staging | production
APP_ENV=development

# ADR-0011 — mock | live. `mock` everywhere except production; CI forces mock
# so no standard suite can spend provider credit (NFR-13, FF-08).
PROVIDER_MODE=mock

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# cicd.md §3 — the running commit SHA, surfaced on the health endpoint.
COMMIT_SHA=unknown

# apps/api
PORT=3000
HOST=0.0.0.0

# workers — graceful drain bound in milliseconds (P1.09 AC-3)
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
