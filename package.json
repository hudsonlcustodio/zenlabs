{
  "name": "zenlabs",
  "version": "0.0.0",
  "private": true,
  "description": "ZENLABS | Laboratório de Clones — provider-agnostic Digital Twin production operating system.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "pnpm -r build",
    "fitness": "node scripts/fitness/run-all.mjs",
    "ff:04": "node scripts/fitness/ff-04-dependency-graph.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "pipeline": "node scripts/ci/run-pipeline.mjs",
    "ff:19": "node scripts/fitness/ff-19-no-committed-secret.mjs",
    "ff:18": "node scripts/fitness/ff-18-openapi-matches-contracts.mjs",
    "openapi:generate": "tsx apps/api/src/openapi/generate.ts",
    "foundation:validate": "node scripts/foundation/validate.mjs",
    "ux:validate": "node scripts/ux/validate.mjs",
    "uiux:validar": "node scripts/uiux/validar.mjs",
    "tech:apply-candidate": "node scripts/tech/apply-candidate-baseline.mjs",
    "tech:check-candidate": "node scripts/tech/check-candidate-baseline.mjs",
    "tech:gate": "node scripts/tech/run-gate.mjs",
    "tech:validate-decision": "node scripts/tech/validate-foundation-decision.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
