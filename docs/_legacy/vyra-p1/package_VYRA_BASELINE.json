{
  "name": "vyra",
  "version": "0.0.0",
  "private": true,
  "description": "VYRA — Digital Twin as a Service. pnpm workspace monorepo (ADR-0002).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "pnpm -r build",
    "fitness": "node scripts/fitness/run-all.mjs",
    "ff:04": "node scripts/fitness/ff-04-dependency-graph.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "pipeline": "node scripts/ci/run-pipeline.mjs",
    "ff:19": "node scripts/fitness/ff-19-no-committed-secret.mjs",
    "ff:18": "node scripts/fitness/ff-18-openapi-matches-contracts.mjs",
    "openapi:generate": "tsx apps/api/src/openapi/generate.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
