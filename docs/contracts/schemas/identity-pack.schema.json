{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenlabs.local/schemas/identity-pack.schema.json",
  "title": "IdentityPack",
  "type": "object",
  "required": [
    "id",
    "tenantId",
    "digitalTwinId",
    "version",
    "status",
    "sourceAssetIds",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "digitalTwinId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "CALIBRATED",
        "ACTIVE",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "sourceAssetIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "canonicalAssetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "characterSheetAssetId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "source",
          "rightsStatus"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "rightsStatus": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "PENDING",
              "RESTRICTED"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
